integrator              = md      
nsteps                  = 100000   
dt                      = 0.001    
nstenergy               = 500  
nstlog                  = 500
nstxout-compressed      = 500 
continuation            = no     
constraint_algorithm    = lincs    
constraints             = h-bonds  
lincs_iter              = 1        
lincs_order             = 4         
cutoff-scheme           = Verlet
ns_type                 = grid     
nstlist                 = 20 
rlist                   = 1.2
vdwtype                 = cutoff
vdw-modifier            = force-switch
rvdw-switch             = 1.0
rvdw                    = 1.2       
coulombtype             = PME      
rcoulomb                = 1.2       
pme_order               = 4        
fourierspacing          = 0.16     
tcoupl                  = V-rescale               
tc-grps                 = Protein Water_and_ions    
tau_t                   = 0.1   0.1                    
ref_t                   = 310   310                     
pcoupl                  = no 
pbc                     = xyz    
DispCorr                = no
gen_vel                 = yes       
gen_temp                = 310    
gen_seed                = -1
